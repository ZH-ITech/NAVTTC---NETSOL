# V3 settings. Copy this file to .env and edit .env locally.
# Never commit .env, never paste it anywhere, never share a screenshot of it.
FLASK_DEBUG=1
MAX_UPLOAD_MB=5
MAX_ROWS=2000
MIN_REVIEW_CHARS=3
MAX_REVIEW_CHARS=1000

# --- Executive report (V3) ---
# REPORT_BACKEND: auto = OpenAI if a key is set, otherwise the template report
#                 openai = try OpenAI first   template = always the template report
REPORT_BACKEND=auto
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-6-luna
OPENAI_TIMEOUT_SECONDS=60
